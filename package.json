{
  "name": "ng-particles-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm run prettify:readme && pnpm run build:lerna",
    "build:ci": "pnpm run prettify:ci:readme && (lerna run build:ci --stream --no-private || pnpm run build:lerna)",
    "build:lerna": "lerna run build --stream --no-private",
    "build:nx": "nx run-many -t build --all",
    "deps:policy:check": "node scripts/check-dependency-policy.mjs",
    "prettify:ci:readme": "prettier --check ./README.md",
    "prettify:readme": "prettier --write ./README.md",
    "build:docs:json": "rimraf docs.json && typedoc --json docs.json",
    "deploy:docs:json": "node deploy.docs-json.js"
  },
  "license": "MIT",
  "dependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lerna": "^8.2.4",
    "nx": "^22.6.4",
    "prettier": "^3.6.2",
    "prettier-plugin-multiline-arrays": "^4.1.5",
    "typedoc": "^0.28.18",
    "typedoc-plugin-carbon-ads": "^1.6.0",
    "typedoc-plugin-clarity": "^1.6.0",
    "typedoc-plugin-coverage": "^4.0.2",
    "typedoc-plugin-keywords": "^1.6.0",
    "typedoc-plugin-missing-exports": "^4.1.3"
  },
  "workspaces": [
    "apps/*",
    "components/*"
  ],
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
